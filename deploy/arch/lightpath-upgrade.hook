# Reports every package this transaction upgrades to the journal, one name
# per line, for lightpathd (its tag: lightpath-alpm-upgrade).
[Trigger]
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Telling Lightpath about upgraded packages...
When = PostTransaction
Exec = /usr/bin/systemd-cat --identifier=lightpath-alpm-upgrade --priority=info
NeedsTargets
