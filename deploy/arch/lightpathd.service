# Lightpath live probe (probe/cmd/lightpathd). Read-only by design: it runs
# fixed inventory commands as the unprivileged hlprobe user and never
# escalates, so it can run with NoNewPrivileges and a read-only system.
[Unit]
Description=Lightpath live probe
Documentation=https://github.com/Imeguras/cf_ai_lightpath
After=systemd-journald.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hlprobe
Group=hlprobe
# Read the whole journal (and so the kernel log without dmesg), query
# libvirt read-only, open /dev/ipmi0 (udev rule in this package).
SupplementaryGroups=systemd-journal libvirt ipmi
ExecStart=/usr/bin/lightpathd -state /var/lib/lightpath -scrub /etc/lightpath/scrub.json -socket /run/lightpath/probe.sock
Restart=on-failure
RestartSec=10s

StateDirectory=lightpath
StateDirectoryMode=0750
RuntimeDirectory=lightpath
RuntimeDirectoryMode=0750
# paru keeps its cache under $HOME.
Environment=HOME=/var/lib/lightpath LC_ALL=C

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/ipmi0 r
# zpool and zfs talk to the module through /dev/zfs (world read-write on
# the host); without it every ZFS probe fails and reads as "pools down".
DeviceAllow=/dev/zfs rw
DevicePolicy=closed
ProtectKernelTunables=yes
# Must stay off: it hides /usr/lib/modules, which modinfo and the module
# directory probes read. Loading modules is impossible anyway (no
# capabilities at all).
ProtectKernelModules=no
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
