# Reports every package this transaction removes to the journal, one name
# per line, for lightpathd (its tag: lightpath-alpm-remove).
[Trigger]
Operation = Remove
Type = Package
Target = *

[Action]
Description = Telling Lightpath about removed packages...
When = PostTransaction
Exec = /usr/bin/systemd-cat --identifier=lightpath-alpm-remove --priority=info
NeedsTargets
