# worker/wrangler.jsonc, the local dev config for `wrangler dev`, rendered
# from worker.tf's locals so bindings are written down once. Regenerate with
# `make wrangler-config` after changing worker.tf.

resource "local_file" "wrangler_dev" {
  filename        = "${path.module}/../../../worker/wrangler.jsonc"
  file_permission = "0644"
  content = join("\n", [
    "// GENERATED by deploy/terraform/worker/wrangler.tf (make wrangler-config).",
    "// Local dev only. Edit deploy/terraform/worker/worker.tf, not this file.",
    jsonencode({
      name               = local.name
      main               = "src/index.ts"
      compatibility_date = local.compatibility_date
      # Workers AI always runs on Cloudflare, even in dev.
      ai = { binding = "AI", remote = true }
      durable_objects = {
        bindings = [for binding, class in local.durable_objects : { name = binding, class_name = class }]
      }
      migrations = [{ tag = "v1", new_sqlite_classes = values(local.durable_objects) }]
      workflows  = [for binding, w in local.workflows : { binding = binding, name = w.name, class_name = w.class }]
      ratelimits = [{
        name         = "RATE_LIMITER"
        namespace_id = local.rate_limit.namespace_id
        simple       = { limit = local.rate_limit.limit, period = local.rate_limit.period }
      }]
      triggers = { crons = local.crons }
      # No gateway in dev; JWT_SECRET comes from .env (see compose.yaml).
      vars = { AI_GATEWAY = "" }
    }),
    "",
  ])
}
