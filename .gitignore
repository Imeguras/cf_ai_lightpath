# Local secrets: .env and any variant (.env.local, .env.prod...), but keep the template.
.env
.env.*
!.env.example

# Raw probe output is private (hostnames, IPs, serials). Only scrubbed fixtures are published.
fixtures/raw/

# Private tooling (the PROMPTS exporter holds the redaction list itself)
private/

# Build output
probe/bin/

# VS Code
.vscode/
*.code-workspace

# Neovim / Vim
*.swp
*.swo
*~
Session.vim
.netrwhist
tags

# Elixir language servers (ElixirLS, Lexical, Next LS, Expert)
.elixir_ls/
.lexical/
.elixir-tools/
.expert/

# OS
.DS_Store

# wrangler dev scratch space
worker/.wrangler/
# esbuild output (make bundle), deployed by Terraform.
worker/dist/

# Terraform: private values, state (holds token values) and provider cache.
# .terraform.lock.hcl stays tracked.
deploy/terraform/terraform.tfvars
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/.terraform/
deploy/terraform/worker/*.tfstate
deploy/terraform/worker/*.tfstate.*
deploy/terraform/worker/.terraform/
deploy/terraform/azure/terraform.tfvars
deploy/terraform/azure/*.tfstate
deploy/terraform/azure/*.tfstate.*
deploy/terraform/azure/.terraform/

# makepkg output (deploy/arch).
deploy/arch/src/
deploy/arch/pkg/
deploy/arch/*.pkg.tar.*
