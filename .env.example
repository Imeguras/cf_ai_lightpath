# Copy to .env (gitignored) and fill in the blanks.

# Phoenix signs and encrypts cookies with this. Generate one with:
#   cd lightpath && mix phx.gen.secret
SECRET_KEY_BASE=

# Hostname Lightpath builds its URLs with.
PHX_HOST=localhost

# Port on 127.0.0.1, and the port the app listens on inside the container.
LIGHTPATH_PORT=4100
