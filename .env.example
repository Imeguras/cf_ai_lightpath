# Copy to .env (gitignored) and fill in the blanks.

# Phoenix signs and encrypts cookies with this. Generate your own with:
#   cd lightpath && mix phx.gen.secret
# The value below is a placeholder of the right length. Never deploy with it.
SECRET_KEY_BASE=CHANGE-ME-not-a-real-secret-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The hostname in the browser's address bar. LiveView refuses its websocket
# from any other origin, so this must match exactly: localhost for dev; the
# server's LAN IP for prod at home for now; later the reverse-proxied name,
# <subdomain>.<your-domain>.
PHX_HOST=localhost

# The deployed Worker (make deploy prints its name; the URL is
# https://lightpath.<your workers.dev subdomain>.workers.dev). Used by the
# prod profile and the Azure demo; empty hides the Explain button.
LIGHTPATH_WORKER_URL=

# On the server, live mode (make home): the numeric id of the hlprobe group
# that lightpathd's package creates, from `getent group hlprobe`.
LIGHTPATH_PROBE_GID=

# Address the published port binds to on the host. 127.0.0.1 keeps it on this
# machine; the server's LAN IP (or 0.0.0.0) exposes it to the LAN for prod.
LIGHTPATH_BIND=127.0.0.1

# Port on LIGHTPATH_BIND, and the port the app listens on inside the container.
LIGHTPATH_PORT=4100

# Cloudflare API token (dash.cloudflare.com/profile/api-tokens): the
# "Edit Cloudflare Workers" template plus Account > Workers AI > Edit/Read,
# filtered to your IPs. Used by Terraform, local dev and the Makefile.
CLOUDFLARE_API_TOKEN=CHANGE-ME-not-a-real-token-xxxxxxxxxxxxxxxxxxxxxxxxxx

# The 32-character hex id in your dashboard URL.
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000

# Shared secret: the web app signs a short-lived JWT (HS256) for every Worker
# request with it, and the Worker checks it. Generate with:
#   openssl rand -hex 32
LIGHTPATH_JWT_SECRET=CHANGE-ME-not-a-real-secret-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
